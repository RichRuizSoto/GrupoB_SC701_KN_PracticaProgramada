@model API.Models.Cliente

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Cliente</h4>
<hr />

<div id="api-alert" class="alert alert-danger d-none" role="alert"></div>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Apellido" class="control-label"></label>
                <input asp-for="Apellido" class="form-control" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Identificacion" class="control-label"></label>
                <input asp-for="Identificacion" class="form-control" />
                <span asp-validation-for="Identificacion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Correo" class="control-label"></label>
                <input asp-for="Correo" class="form-control" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Direccion" class="control-label"></label>
                <input asp-for="Direccion" class="form-control" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="fechaNacimiento" class="control-label"></label>
                <input asp-for="fechaNacimiento" type="date" class="form-control" />
                <span asp-validation-for="fechaNacimiento" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Teléfonos</label>

                <div id="telefonos-container">
                    @if (Model.Telefonos != null && Model.Telefonos.Any())
                    {
                        for (int i = 0; i < Model.Telefonos.Count; i++)
                        {
                            <div class="telefono-item mb-3">
                                <input type="hidden" name="Telefonos[@i].Id" value="@Model.Telefonos[i].Id" />

                                <label>Número</label>
                                <input name="Telefonos[@i].Numero"
                                       value="@Model.Telefonos[i].Numero"
                                       class="form-control" />

                                <label>Tipo</label>
                                <input name="Telefonos[@i].Tipo"
                                       value="@Model.Telefonos[i].Tipo"
                                       class="form-control" />

                                <button type="button"
                                        class="btn btn-danger btn-sm mt-2"
                                        onclick="eliminarTelefono(this, @Model.Telefonos[i].Id)">
                                    Eliminar
                                </button>
                            </div>
                        }
                    }
                </div>

                <div id="telefonos-eliminados"></div>

                <button type="button" class="btn btn-secondary mt-2" onclick="agregarTelefono()">
                    Agregar teléfono
                </button>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let telefonoIndex = @(Model.Telefonos?.Count ?? 0);

        function agregarTelefono() {
            const container = document.getElementById("telefonos-container");

            const html = `
                <div class="telefono-item mb-3">
                    <input type="hidden" name="Telefonos[${telefonoIndex}].Id" value="0" />

                    <label>Número</label>
                    <input name="Telefonos[${telefonoIndex}].Numero" class="form-control" />

                    <label>Tipo</label>
                    <input name="Telefonos[${telefonoIndex}].Tipo" class="form-control" />

                    <button type="button"
                            class="btn btn-danger btn-sm mt-2"
                            onclick="eliminarTelefono(this, 0)">
                        Eliminar
                    </button>
                </div>
            `;

            container.insertAdjacentHTML("beforeend", html);
            telefonoIndex++;
        }

        function eliminarTelefono(button, telefonoId) {
            if (telefonoId > 0) {
                document.getElementById("telefonos-eliminados").insertAdjacentHTML(
                    "beforeend",
                    `<input type="hidden" name="TelefonosEliminados" value="${telefonoId}" />`
                );
            }

            button.closest(".telefono-item").remove();
        }
    </script>
}
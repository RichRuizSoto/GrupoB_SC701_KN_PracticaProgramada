@model API.Models.Cliente

@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="card-custom">

    <h2 class="mb-4">
        Registrar Cliente
    </h2>

    <form asp-action="Create">

        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Nombre
                </label>

                <input asp-for="Nombre"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Apellido
                </label>

                <input asp-for="Apellido"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Identificación
                </label>

                <input asp-for="Identificacion"
                       class="form-control" />

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Correo
                </label>

                <input asp-for="Correo"
                       class="form-control" />

            </div>

            <div class="col-12 mb-4">

                <label class="form-label">
                    Dirección
                </label>

                <input asp-for="Direccion"
                       class="form-control" />

            </div>

        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5>
                Teléfonos
            </h5>

            <button type="button"
                    class="btn btn-secondary"
                    onclick="agregarTelefono()">

                Agregar Teléfono

            </button>

        </div>

        <div id="telefonos-container">

            <div class="border rounded p-3 mb-3 telefono-item">

                <div class="row">

                    <div class="col-md-5">

                        <label>Número</label>

                        <input name="Telefonos[0].Numero"
                               class="form-control" />

                    </div>

                    <div class="col-md-5">

                        <label>Tipo</label>

                        <select name="Telefonos[0].Tipo"
                                class="form-select">

                            <option>Móvil</option>
                            <option>Casa</option>
                            <option>Trabajo</option>

                        </select>

                    </div>

                    <div class="col-md-2 d-flex align-items-end">

                        <button type="button"
                                class="btn btn-danger w-100"
                                onclick="this.closest('.telefono-item').remove()">

                            Eliminar

                        </button>

                    </div>

                </div>

            </div>

        </div>

        <div class="mt-4">

            <button type="submit"
                    class="btn btn-success">

                Guardar Cliente

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Volver

            </a>

        </div>

    </form>

</div>

@section Scripts {

    <script>

        let indiceTelefono = 1;

        function agregarTelefono() {

            const container =
                document.getElementById("telefonos-container");

            const html = `

            <div class="border rounded p-3 mb-3 telefono-item">

                <div class="row">

                    <div class="col-md-5">

                        <label>Número</label>

                        <input name="Telefonos[${indiceTelefono}].Numero"
                               class="form-control" />

                    </div>

                    <div class="col-md-5">

                        <label>Tipo</label>

                        <select name="Telefonos[${indiceTelefono}].Tipo"
                                class="form-select">

                            <option>Móvil</option>
                            <option>Casa</option>
                            <option>Trabajo</option>

                        </select>

                    </div>

                    <div class="col-md-2 d-flex align-items-end">

                        <button type="button"
                                class="btn btn-danger w-100"
                                onclick="this.closest('.telefono-item').remove()">

                            Eliminar

                        </button>

                    </div>

                </div>

            </div>
            `;

            container.insertAdjacentHTML("beforeend", html);

            indiceTelefono++;

        }

    </script>

}
<!DOCTYPE html>
<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Directorio Telefónico</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

            html, body {
                height: 100%;
            }

            body {
                background-color: #f4f6f9;
                font-family: Arial, Helvetica, sans-serif;
                display: flex;
                flex-direction: column;
            }

            .navbar-custom {
                background-color: #1f2937;
                padding: 15px;
            }

            .navbar-brand {
                color: white !important;
                font-size: 24px;
                font-weight: bold;
            }

            .main-container {
                flex: 1;
                margin-top: 40px;
                margin-bottom: 40px;
            }

            .cliente-card {
                background: white;
                border-radius: 12px;
                padding: 25px;
                box-shadow: 0 3px 10px rgba(0,0,0,0.08);
                height: 100%;
            }

            .cliente-nombre {
                font-size: 22px;
                font-weight: bold;
                color: #1f2937;
            }

            .cliente-info {
                color: #6b7280;
                margin-bottom: 8px;
            }

            .telefono-item {
                background-color: #eef2ff;
                padding: 8px 12px;
                border-radius: 8px;
                margin-bottom: 8px;
            }

            .btn-custom {
                width: 100%;
                margin-top: 8px;
            }

            .footer-custom {
                background-color: #1f2937;
                color: white;
                text-align: center;
                padding: 15px;
            }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Cliente"
               asp-action="Index">

                Directorio Telefónico

            </a>

            <div class="navbar-nav ms-auto flex-row gap-3">

                <a class="nav-link text-white"
                   asp-controller="Cliente"
                   asp-action="Index">

                    Clientes

                </a>

                <a class="nav-link text-white"
                   asp-controller="CitaLavado"
                   asp-action="Index">

                    Citas

                </a>

                <a class="nav-link text-white"
                   asp-controller="Vehiculo"
                   asp-action="Index">

                    Vehiculos

                </a>

            </div>

        </div>

    </nav>

    <div class="container main-container">

        @RenderBody()

    </div>

    <footer class="footer-custom">

        Práctica programada 1 Grupo B

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

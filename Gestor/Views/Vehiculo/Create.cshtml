@model API.Models.Vehiculo

@{
    ViewData["Title"] = "Nuevo Vehículo";
    var clientes = ViewBag.Clientes as List<API.Models.Cliente> ?? new List<API.Models.Cliente>();
}

<h1>Nuevo Vehículo</h1>

<h4>Vehículo</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-group mb-3">
                <label asp-for="Matricula" class="control-label"></label>
                <input asp-for="Matricula" class="form-control" />
                <span asp-validation-for="Matricula" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Marca" class="control-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Modelo" class="control-label"></label>
                <input asp-for="Modelo" class="form-control" />
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Color" class="control-label"></label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Anio" class="control-label"></label>
                <input asp-for="Anio" type="number" class="form-control" />
                <span asp-validation-for="Anio" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="control-label">Cliente dueño</label>
                <select asp-for="ClienteId" class="form-select">
                    <option value="">Seleccione un cliente</option>
                    @foreach (var cliente in clientes)
                    {
                        <option value="@cliente.Id">
                            @cliente.Nombre @cliente.Apellido
                        </option>
                    }
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
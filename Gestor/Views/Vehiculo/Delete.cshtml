@model API.Models.Vehiculo

@{
    ViewData["Title"] = "Eliminar Vehículo";
}

<h1>Eliminar Vehículo</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}

<h3>¿Estás seguro de que deseas eliminar este vehículo?</h3>

<div>
    <h4>Vehículo</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Matrícula</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Matricula)</dd>

        <dt class="col-sm-2">Marca</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Marca)</dd>

        <dt class="col-sm-2">Modelo</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Modelo)</dd>

        <dt class="col-sm-2">Color</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Color)</dd>

        <dt class="col-sm-2">Año</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Anio)</dd>

        <dt class="col-sm-2">Cliente dueño</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ClienteId)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>